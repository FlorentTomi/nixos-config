;; CPU / RAM / GPU / disk, one combined poll, backed by scripts/sysmon.sh.

(defpoll SYSMON :interval "2s" :initial "{\"cpu\":{\"pct\":0},\"mem\":{\"used\":0,\"total\":0,\"pct\":0,\"used_gb\":\"0.0\",\"total_gb\":\"0.0\"},\"disk\":{\"used\":0,\"total\":0,\"pct\":0},\"gpu\":{\"util\":0,\"mem_used\":0,\"mem_total\":0,\"temp\":0}}"
  "scripts/sysmon.sh")

(defwidget sysmon-bar [label value unit]
  (box :class "sysmon-row" :orientation "v" :space-evenly false :spacing 2
    (box :orientation "h" :space-evenly false
      (label :class "sysmon-label" :halign "start" :hexpand true :text label)
      (label :class "sysmon-value" :text "${value}${unit}"))
    (progress :class "sysmon-progress" :value value)))

(defwidget sysmon-widget []
  (box :class "genwin sysmon" :orientation "v" :space-evenly false :spacing 10
    (sysmon-bar :label "CPU" :value {SYSMON.cpu.pct} :unit "%")
    (sysmon-bar :label "MEM  ${SYSMON.mem.used_gb}/${SYSMON.mem.total_gb}G" :value {SYSMON.mem.pct} :unit "%")
    (sysmon-bar :label "GPU  ${SYSMON.gpu.mem_used}/${SYSMON.gpu.mem_total}MB" :value {SYSMON.gpu.util} :unit "%  ${SYSMON.gpu.temp}°C")
    (sysmon-bar :label "DISK  ${SYSMON.disk.used}/${SYSMON.disk.total}G" :value {SYSMON.disk.pct} :unit "%")))

(defwindow sysmon
  :stacking "bg"
  :focusable "false"
  :geometry (geometry :x 8 :y 685 :width 350 :height 190 :anchor "top left")
  (sysmon-widget))
