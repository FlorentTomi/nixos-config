(defwidget dashboard-widget []
    (box :orientation "v" :class "dashboard-bg" :space-evenly false :vexpand "false" :hexpand "false" :spacing 8
        (clock-widget)
        (calendar-widget)
        (media-widget)
        (weather-widget)))

(defwindow dashboard
    :stacking "bg"
    :focusable "false"
    :namespace "eww-dashboard"
    :geometry (geometry
        :x 8
        :y 8
        :width 350
        :anchor "top right")
   	(dashboard-widget))