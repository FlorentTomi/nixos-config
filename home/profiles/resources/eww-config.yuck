(defpoll HOUR :interval "5s" `date +\"%H\"`)
(defpoll MIN :interval "5s" `date +\"%M\"`)
(defpoll DAY :interval "5s" `date +\"%A\"`)

(defpoll CURRENT_DAY   :interval "30s" "date +\"%-d\"")
(defpoll CURRENT_MONTH :interval "30s" "date +\"%-m\"")
(defpoll CURRENT_YEAR  :interval "30s" "date +\"%Y\"")

(defwidget clock-widget []
    (box :class "genwin" :orientation "h" :space-evenly false :vexpand "false" :hexpand "false" 
        (box :orientation "h" :spacing 0
			(label :class "time-hour" :valign "start" :wrap "true" :limit-width 25 :text HOUR)
			(label :class "time-min" :valign "end" :wrap "true" :limit-width 25 :text MIN))
		(box :orientation "v" :spacing 0 :halign "end" :hexpand "true" 
			(label :class "time-day" :valign "start" :halign "end" :wrap "true" :limit-width 25 :text DAY))))

(defwindow clock
    :stacking "bg" 
    :focusable "false"
    :geometry (geometry 
        :x 8 
        :y 8 
        :width 350 
        :height 155
        :anchor "top left")
   	(clock-widget))

(defwidget calendar-widget []
    (box :class "genwin"
        (calendar 
            :halign "start" 
            :valign "start" 
            :show-details true
            :active false
            :width 350 
            :class "calendar" 
            :day CURRENT_DAY
            :month CURRENT_MONTH
            :year CURRENT_YEAR)))

(defwindow calendar
    :stacking "bg" 
    :focusable "false"
    :geometry (geometry 
        :x 8
        :y 171
        :width 350
        :height 160
        :anchor "top left")
    (calendar-widget))