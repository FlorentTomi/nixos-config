;; MPRIS now-playing card, backed by scripts/media.sh (playerctl).

(deflisten MEDIA :initial "{\"status\":\"Stopped\",\"title\":\"\",\"artist\":\"\",\"album\":\"\",\"art\":\"\"}"
  "scripts/media.sh")

(defwidget media-widget []
  (box :class "genwin media" :orientation "h" :space-evenly false :spacing 12
    (box :class "media-art" :visible {MEDIA.art != ""}
      (image :path {MEDIA.art} :image-width 72 :image-height 72))
    (box :class "media-art media-art-placeholder" :visible {MEDIA.art == ""}
      (label :text "♪"))
    (box :orientation "v" :space-evenly false :valign "center" :hexpand true
      (label :class "media-title" :halign "start" :wrap true :limit-width 26
        :text {MEDIA.title == "" ? "Nothing playing" : MEDIA.title})
      (label :class "media-artist" :halign "start" :wrap true :limit-width 30
        :text {MEDIA.artist}{MEDIA.album != "" ? "  ·  ${MEDIA.album}" : ""})
      (box :class "media-controls" :orientation "h" :space-evenly false :spacing 6 :halign "start"
        (button :class "media-btn" :onclick "playerctl previous"
          (box :width 20 :height 20 :halign "center" :valign "center" "⏮"))
        (button :class "media-btn media-btn-main" :onclick "playerctl play-pause"
          (overlay
            (box :width 20 :height 20 :halign "center" :valign "center"
              :class {MEDIA.status == "Playing" ? "media-icon-show" : "media-icon-hide"}
              "⏸")
            (box :width 20 :height 20 :halign "center" :valign "center"
              :class {MEDIA.status == "Playing" ? "media-icon-hide" : "media-icon-show"}
              "▶")))
        (button :class "media-btn" :onclick "playerctl next"
          (box :width 20 :height 20 :halign "center" :valign "center" "⏭"))))))

(defwindow media
  :stacking "bg"
  :focusable "false"
  :geometry (geometry :x 8 :y 459 :width 350 :height 100 :anchor "top left")
  (media-widget))
